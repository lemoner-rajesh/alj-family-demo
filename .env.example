# Copy to .env and set your own values to enable HTTP Basic Auth on
# `npm run dev` / `npm run preview`. Leave unset to disable auth locally.
#
# This only covers local dev/preview. On Vercel, auth is enforced separately
# by middleware.js (Edge Middleware) — set these same two names in the
# Vercel project's own Settings → Environment Variables too; this .env file
# never reaches the deployed edge runtime.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
